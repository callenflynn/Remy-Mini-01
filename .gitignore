# Rust build output. `cargo build` recreates it: 13k+ files, hundreds of MB, some binaries
# individually larger than GitHub's 100 MB file limit.
/target/

# Training corpora. Downloaded or generated inputs, not source: ~600 MB of raw text, and several
# files individually exceed GitHub's 100 MB limit. The cleaned copy is rebuilt with
# `lm-cli clean --out data/cleaned-pretrain`; the raw sources live outside version control.
/data/speeches/
/data/forums/
/data/wikipedia-core/
/data/misc/
/data/english-wordnet-2025-json/
/data/cleaned-pretrain/

# Run output. Prepared records, tokenizer corpora, weights, adapters and optimizer states are all
# regenerated by `lm-cli prepare` / `lm-cli train` / `lm-cli export`. Only the recipe is source.
/runs/*
!/runs/soup.yaml

# Python bytecode from the data scripts.
__pycache__/
*.py[cod]

# Local scratch output.
nohup.out
*.log
